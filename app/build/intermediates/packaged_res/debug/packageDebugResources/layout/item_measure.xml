<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/measureNumberText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Measure 1"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/strummingPatternText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="D D D D"
                android:textColor="@android:color/holo_blue_dark"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/dragHandle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Drag to reorder"
                android:src="@drawable/ic_drag_handle" />

            <TextView
                android:id="@+id/quarterNote1"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/quarter_note_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="-"
                android:textColor="@android:color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quarterNote2"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/quarter_note_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="-"
                android:textColor="@android:color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quarterNote3"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/quarter_note_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="-"
                android:textColor="@android:color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quarterNote4"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/quarter_note_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="-"
                android:textColor="@android:color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/removeMeasureButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Remove measure"
                android:src="@android:drawable/ic_delete"
                app:tint="?android:attr/textColorSecondary" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
