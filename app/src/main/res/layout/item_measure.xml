<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/measureNumberText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="1"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Flexible spacer pushes the piano+drum icons + pattern area to the right -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Piano mini keyboard icon (left of the drumset) -->
            <ImageView
                android:id="@+id/pianoIcon"
                android:layout_width="40dp"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/keyboard"
                android:src="@drawable/ic_piano_keys"
                android:scaleType="centerInside" />

            <!-- Drum icon (positioned right of the piano, left of the strum pattern) -->
            <ImageView
                android:id="@+id/drumIcon"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/drums_label"
                android:src="@drawable/ic_drum_color"
                android:scaleType="centerInside" />

            <!-- Horizontal scrolling container showing small chips for each strum (D/U/M/_)
                 set to wrap_content so it sits right after the drum icon -->
            <HorizontalScrollView
                android:id="@+id/strummingPatternScroll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/strumContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:gravity="end|center_vertical"
                    android:minHeight="@dimen/strum_chip_size" />

            </HorizontalScrollView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/dragHandle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/drag_to_reorder"
                android:src="@drawable/ic_drag_handle" />

            <TextView
                android:id="@+id/quarterNote1"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/quarter_note_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/dash"
                android:textColor="@android:color/black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quarterNote2"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/quarter_note_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/dash"
                android:textColor="@android:color/black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quarterNote3"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/quarter_note_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/dash"
                android:textColor="@android:color/black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quarterNote4"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/quarter_note_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/dash"
                android:textColor="@android:color/black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/removeMeasureButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/remove_measure"
                android:src="@android:drawable/ic_delete"
                app:tint="?android:attr/textColorSecondary" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
