<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Song name + menu button -->
    <LinearLayout
        android:id="@+id/songNameContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/songNameEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/song_name_default"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:paddingStart="4dp" />

        <ImageButton
            android:id="@+id/songMenuButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/song_section_actions_cd"
            android:src="@drawable/ic_menu_overflow" />
    </LinearLayout>

    <!-- Section list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/songSectionsRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toTopOf="@id/controlsCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/songNameContainer"
        tools:itemCount="4"
        tools:listitem="@layout/item_section" />

    <!-- Playback controls -->
    <LinearLayout
        android:id="@+id/controlsCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_controls_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Volume row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="2dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_volume"
                android:contentDescription="@string/volume_label"
                app:tint="?attr/colorOnSurface"
                android:alpha="0.7" />

            <SeekBar
                android:id="@+id/volumeSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:max="15" />

        </LinearLayout>

        <!-- Buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/songPlayButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_play_arrow"
                android:contentDescription="@string/play_pause_cd"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_primary_button_ripple"
                android:hapticFeedbackEnabled="false"
                app:tint="?attr/colorOnPrimary"
                android:scaleType="centerInside"
                android:elevation="4dp" />

            <ImageButton
                android:id="@+id/songStopButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_stop"
                android:enabled="false"
                android:alpha="0.4"
                android:contentDescription="@string/stop_cd"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_primary_button_ripple"
                android:hapticFeedbackEnabled="false"
                app:tint="?attr/colorOnPrimary"
                android:scaleType="centerInside"
                android:elevation="4dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/songRepeatButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_repeat_toggle_ripple"
                android:hapticFeedbackEnabled="false"
                android:src="@drawable/ic_repeat"
                app:tint="?attr/colorOnPrimary"
                android:contentDescription="@string/toggle_repeat"
                android:elevation="4dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
