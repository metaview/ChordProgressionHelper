<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Scrollable list of all measure rows -->
    <ScrollView
        android:id="@+id/measureScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/keyboardArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/measureListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

    </ScrollView>

    <!-- Fixed keyboard area, sits above the button bar -->
    <LinearLayout
        android:id="@+id/keyboardArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toTopOf="@id/buttonBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Keyboard container: white keys with overlayed black keys -->
        <FrameLayout
            android:id="@+id/keyboardFrame"
            android:layout_width="match_parent"
            android:layout_height="120dp">

                <LinearLayout
                    android:id="@+id/whiteKeys"
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    <!-- 10 white keys: B C D E F G A B C D -->
                    <Button
                        android:id="@+id/keyBLow"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/white_key_selector"
                        android:backgroundTint="@null"
                        android:text="" />

                    <Button
                        android:id="@+id/keyC"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/white_key_selector"
                        android:backgroundTint="@null"
                        android:text="" />

                    <Button
                        android:id="@+id/keyD"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/white_key_selector"
                        android:backgroundTint="@null"
                        android:text="" />

                    <Button
                        android:id="@+id/keyE"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/white_key_selector"
                        android:backgroundTint="@null"
                        android:text="" />

                    <Button
                        android:id="@+id/keyF"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/white_key_selector"
                        android:backgroundTint="@null"
                        android:text="" />

                    <Button
                        android:id="@+id/keyG"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/white_key_selector"
                        android:backgroundTint="@null"
                        android:text="" />

                    <Button
                        android:id="@+id/keyA"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/white_key_selector"
                        android:backgroundTint="@null"
                        android:text="" />

                    <Button
                        android:id="@+id/keyB"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/white_key_selector"
                        android:backgroundTint="@null"
                        android:text="" />

                    <Button
                        android:id="@+id/keyCHigh"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/white_key_selector"
                        android:backgroundTint="@null"
                        android:text="" />

                    <Button
                        android:id="@+id/keyDHigh"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/white_key_selector"
                        android:backgroundTint="@null"
                        android:text="" />
                </LinearLayout>

                <!-- Black keys overlay (positioned with margins) -->
                <LinearLayout
                    android:id="@+id/blackKeys"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    <!-- Use spacers to position black keys over gaps between white keys -->
                    <!-- No black key before B-Low (it's at the start) -->
                    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="0.5" />
                    <!-- No black key between B and C (half step) -->
                    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                    <!-- C# between C and D -->
                    <Button
                        android:id="@+id/keyCs"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_weight="1"
                        android:background="@drawable/black_key_selector"
                        android:backgroundTint="@null"
                        android:text="" />
                    <!-- D# between D and E -->
                    <Button
                        android:id="@+id/keyDs"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_weight="1"
                        android:background="@drawable/black_key_selector"
                        android:backgroundTint="@null"
                        android:text="" />
                    <!-- No black key between E and F (half step) -->
                    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                    <!-- F# between F and G -->
                    <Button
                        android:id="@+id/keyFs"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_weight="1"
                        android:background="@drawable/black_key_selector"
                        android:backgroundTint="@null"
                        android:text="" />
                    <!-- G# between G and A -->
                    <Button
                        android:id="@+id/keyGs"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_weight="1"
                        android:background="@drawable/black_key_selector"
                        android:backgroundTint="@null"
                        android:text="" />
                    <!-- A# between A and B -->
                    <Button
                        android:id="@+id/keyAs"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_weight="1"
                        android:background="@drawable/black_key_selector"
                        android:backgroundTint="@null"
                        android:text="" />
                    <!-- No black key between B and C-High (half step) -->
                    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                    <!-- C# High between C-High and D-High -->
                    <Button
                        android:id="@+id/keyCsHigh"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_weight="1"
                        android:background="@drawable/black_key_selector"
                        android:backgroundTint="@null"
                        android:text="" />
                    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="0.5" />
                </LinearLayout>

                <!-- C labels overlayed on white keys at the bottom -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="bottom"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:paddingBottom="8dp">
                    <!-- Empty TextView for B-Low -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <!-- C label -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingLeft="8dp"
                        android:text="C"
                        android:gravity="center"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <!-- Empty TextViews for D, E, F, G, A, B -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <!-- C label for C-High -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingLeft="8dp"
                        android:text="C"
                        android:gravity="center"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <!-- Empty TextView for D-High -->
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </FrameLayout>

        <!-- Octave display and controls: moved below keyboard -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <ImageButton
                android:id="@+id/octaveDown"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_left"
                android:contentDescription="@string/octave_down"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/octaveText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textSize="16sp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <ImageButton
                android:id="@+id/octaveUp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_right"
                android:contentDescription="@string/octave_up"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <Space
                android:layout_width="16dp"
                android:layout_height="0dp" />

            <Button
                android:id="@+id/iconRest"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="-"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:contentDescription="@string/rest"
                android:background="@drawable/purple_button_bg"
                android:backgroundTint="@null" />

            <Space
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <Button
                android:id="@+id/iconLetRing"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text=" "
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:contentDescription="@string/let_ring"
                android:background="@drawable/purple_button_bg"
                android:backgroundTint="@null" />

        </LinearLayout>

    </LinearLayout>

    <!-- Fixed button bar at the bottom, always visible -->
    <LinearLayout
        android:id="@+id/buttonBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreview"
            style="@style/Widget.ChordProgressionHelper.MaterialButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/test"
            app:icon="@drawable/ic_play_arrow"
            app:iconTint="@color/colorOnPrimary"
            app:iconPadding="0dp"
            app:iconGravity="textStart"
            android:padding="8dp" />

        <!-- flexible spacer pushes the following buttons to the right -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOk"
            style="@style/Widget.ChordProgressionHelper.MaterialButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save" />


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
