<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/piano_editor_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Octave controls + keyboard -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/octaveDown"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_left"
                android:contentDescription="@string/octave_down"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <!-- Keyboard container: white keys with overlayed black keys -->
            <FrameLayout
                android:id="@+id/keyboardFrame"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp">

                <LinearLayout
                    android:id="@+id/whiteKeys"
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    <!-- 7 white keys (C D E F G A B) -->
                    <Button
                        android:id="@+id/keyC"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/white_key_selector"
                        android:backgroundTint="@null"
                        android:text="" />

                    <Button
                        android:id="@+id/keyD"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/white_key_selector"
                        android:backgroundTint="@null"
                        android:text="" />

                    <Button
                        android:id="@+id/keyE"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/white_key_selector"
                        android:backgroundTint="@null"
                        android:text="" />

                    <Button
                        android:id="@+id/keyF"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/white_key_selector"
                        android:backgroundTint="@null"
                        android:text="" />

                    <Button
                        android:id="@+id/keyG"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/white_key_selector"
                        android:backgroundTint="@null"
                        android:text="" />

                    <Button
                        android:id="@+id/keyA"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/white_key_selector"
                        android:backgroundTint="@null"
                        android:text="" />

                    <Button
                        android:id="@+id/keyB"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/white_key_selector" android:backgroundTint="@null" android:text="" />
                </LinearLayout>

                <!-- Black keys overlay (positioned with margins) -->
                <LinearLayout
                    android:id="@+id/blackKeys"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    <!-- Use spacers to position black keys over gaps -->
                    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="0.5" />
                    <Button android:id="@+id/keyCs" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="0.5" android:layout_marginLeft="-12dp" android:layout_marginRight="-12dp" android:background="@drawable/black_key_selector" android:backgroundTint="@null" android:text="" />
                    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="0.5" />
                    <Button android:id="@+id/keyDs" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="0.5" android:layout_marginLeft="-12dp" android:layout_marginRight="-12dp" android:background="@drawable/black_key_selector" android:backgroundTint="@null" android:text="" />
                    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                    <Button android:id="@+id/keyFs" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="0.5" android:layout_marginLeft="-12dp" android:layout_marginRight="-12dp" android:background="@drawable/black_key_selector" android:backgroundTint="@null" android:text="" />
                    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="0.5" />
                    <Button android:id="@+id/keyGs" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="0.5" android:layout_marginLeft="-12dp" android:layout_marginRight="-12dp" android:background="@drawable/black_key_selector" android:backgroundTint="@null" android:text="" />
                    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="0.5" />
                    <Button android:id="@+id/keyAs" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="0.5" android:layout_marginLeft="-12dp" android:layout_marginRight="-12dp" android:background="@drawable/black_key_selector" android:backgroundTint="@null" android:text="" />
                    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="0.5" />
                </LinearLayout>
            </FrameLayout>

            <ImageButton
                android:id="@+id/octaveUp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_right"
                android:contentDescription="@string/octave_up"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>

        <!-- Octave display and small action icons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/octaveText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textSize="16sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <ImageButton
                android:id="@+id/iconRest"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_strum_rest"
                android:contentDescription="@string/rest"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageButton
                android:id="@+id/iconLetRing"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_strum_letring"
                android:contentDescription="@string/let_ring"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>

    </LinearLayout>

    <!-- Row with 8 slots for the monophonic melody (one measure = 8 eighth notes) -->
    <LinearLayout
        android:id="@+id/slotsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:weightSum="8">

        <!-- Slot views: use Button styled similarly to Strumming slots (purple) -->
        <Button
            android:id="@+id/slot0"
            style="@style/Widget.App.Button.Purple"
            android:background="@drawable/purple_button_bg"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/dash" />

        <Button
            android:id="@+id/slot1"
            style="@style/Widget.App.Button.Purple"
            android:background="@drawable/purple_button_bg"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/dash" />

        <Button
            android:id="@+id/slot2"
            style="@style/Widget.App.Button.Purple"
            android:background="@drawable/purple_button_bg"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/dash" />

        <Button
            android:id="@+id/slot3"
            style="@style/Widget.App.Button.Purple"
            android:background="@drawable/purple_button_bg"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/dash" />

        <Button
            android:id="@+id/slot4"
            style="@style/Widget.App.Button.Purple"
            android:background="@drawable/purple_button_bg"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/dash" />

        <Button
            android:id="@+id/slot5"
            style="@style/Widget.App.Button.Purple"
            android:background="@drawable/purple_button_bg"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/dash" />

        <Button
            android:id="@+id/slot6"
            style="@style/Widget.App.Button.Purple"
            android:background="@drawable/purple_button_bg"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/dash" />

        <Button
            android:id="@+id/slot7"
            style="@style/Widget.App.Button.Purple"
            android:background="@drawable/purple_button_bg"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/dash" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnOk"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/save" />

        <Button
            android:id="@+id/btnCancel"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cancel"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
