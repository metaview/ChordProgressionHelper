<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".SettingsActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="24sp"
        android:textStyle="bold" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/chordPreviewSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:minHeight="48dp"
        android:text="Chord Preview"
        android:textSize="16sp" />
        
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/loopByDefaultSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="Loop by Default"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Count In"
        android:textSize="16sp" />

    <RadioGroup
        android:id="@+id/countInRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/countInNone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Count In" />

        <RadioButton
            android:id="@+id/countIn2Beats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2 Beats" />

        <RadioButton
            android:id="@+id/countIn4Beats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4 Beats" />

        <RadioButton
            android:id="@+id/countIn8Beats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8 Beats" />
    </RadioGroup>

    <!-- Sound subgroup -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Sound"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/drumLevelLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Drum Level: 100%" />

    <SeekBar
        android:id="@+id/drumLevelSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="200"
        android:progress="100" />

    <TextView
        android:id="@+id/envelopeScaleLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Envelope Scale: 100%" />

    <SeekBar
        android:id="@+id/envelopeScaleSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="200"
        android:progress="100" />

    <TextView
        android:id="@+id/hihatHighpassLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="HiHat Highpass: 100%" />

    <SeekBar
        android:id="@+id/hihatHighpassSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="200"
        android:progress="100" />

    <!-- Reset button for sound settings -->
    <Button
        android:id="@+id/resetSoundButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Reset Sound" />

</LinearLayout>
