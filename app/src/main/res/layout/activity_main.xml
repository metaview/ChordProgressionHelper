<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/keyLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/key_label"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Spinner
        android:id="@+id/keySpinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:minHeight="48dp"
        app:layout_constraintBottom_toBottomOf="@id/keyLabel"
        app:layout_constraintEnd_toStartOf="@id/bpmControlsLayout"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@id/keyLabel"
        app:layout_constraintTop_toTopOf="@id/keyLabel" />

    <LinearLayout
        android:id="@+id/bpmControlsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/keyLabel"
        app:layout_constraintEnd_toStartOf="@id/menuButton"
        app:layout_constraintTop_toTopOf="@id/keyLabel">

        <TextView
            android:id="@+id/bpmLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bpm_label"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/bpmEditText"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:inputType="number"
            android:text="@string/bpm_default"
            android:hint="@string/bpm_hint"
            android:importantForAutofill="no" />

        <LinearLayout
            android:layout_width="32dp"
            android:layout_height="48dp"
            android:orientation="vertical"
            android:layout_marginStart="4dp">

            <ImageButton
                android:id="@+id/bpmUpButton"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/increase_bpm"
                android:paddingTop="12dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/arrow_up_float" />

            <ImageButton
                android:id="@+id/bpmDownButton"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="2dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/decrease_bpm"
                android:paddingBottom="4dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/arrow_down_float" />
        </LinearLayout>

    </LinearLayout>

    <ImageButton
        android:id="@+id/menuButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_menu_overflow"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/menu_cd"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/keyLabel"/>

    <TextView
        android:id="@+id/chordsLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/available_chords"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/keySpinner" />
        
    <ImageButton
        android:id="@+id/expandRelatedChordsButton"
        android:layout_width="48dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_expand_more"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/expand_related_cd"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/chordsLabel" />

    <FrameLayout
        android:id="@+id/chordContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chordsLabel">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chordRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:clipToPadding="false"
            android:scrollbars="horizontal"
            android:scrollbarStyle="outsideOverlay"
            tools:itemCount="7"
            tools:listitem="@layout/item_chord" />

        <View
            android:id="@+id/chordFadeLeft"
            android:layout_width="@dimen/fade_edge_length"
            android:layout_height="match_parent"
            android:background="@drawable/fade_left"
            android:layout_gravity="start" />

        <View
            android:id="@+id/chordFadeRight"
            android:layout_width="@dimen/fade_edge_length"
            android:layout_height="match_parent"
            android:background="@drawable/fade_right"
            android:layout_gravity="end" />

    </FrameLayout>

    <TextView
        android:id="@+id/relatedChordsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/secondary_dominants"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chordContainer" />

    <FrameLayout
        android:id="@+id/relatedChordContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/relatedChordsLabel">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/relatedChordRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:clipToPadding="false"
            android:scrollbars="horizontal"
            android:scrollbarStyle="outsideOverlay"
            android:visibility="gone"
            tools:itemCount="7"
            tools:listitem="@layout/item_chord" />

        <View
            android:id="@+id/relatedFadeLeft"
            android:layout_width="@dimen/fade_edge_length"
            android:layout_height="match_parent"
            android:background="@drawable/fade_left"
            android:layout_gravity="start" />

        <View
            android:id="@+id/relatedFadeRight"
            android:layout_width="@dimen/fade_edge_length"
            android:layout_height="match_parent"
            android:background="@drawable/fade_right"
            android:layout_gravity="end" />

    </FrameLayout>

    <TextView
        android:id="@+id/borrowedChordsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/parallel_chords"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/relatedChordContainer" />

    <LinearLayout
        android:id="@+id/borrowedMinorContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/borrowedChordsLabel">

        <TextView
            android:id="@+id/borrowedMinorLabel"
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/borrowedMinorChordRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:clipToPadding="false"
                android:scrollbars="horizontal"
                android:scrollbarStyle="outsideOverlay"
                tools:itemCount="7"
                tools:listitem="@layout/item_chord" />

            <View
                android:id="@+id/borrowedMinorFadeLeft"
                android:layout_width="@dimen/fade_edge_length"
                android:layout_height="match_parent"
                android:background="@drawable/fade_left"
                android:layout_gravity="start" />

            <View
                android:id="@+id/borrowedMinorFadeRight"
                android:layout_width="@dimen/fade_edge_length"
                android:layout_height="match_parent"
                android:background="@drawable/fade_right"
                android:layout_gravity="end" />

        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/borrowedMajorContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/borrowedMinorContainer">

        <TextView
            android:id="@+id/borrowedMajorLabel"
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/borrowedMajorChordRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:clipToPadding="false"
                android:scrollbars="horizontal"
                android:scrollbarStyle="outsideOverlay"
                tools:itemCount="7"
                tools:listitem="@layout/item_chord" />

            <View
                android:id="@+id/borrowedMajorFadeLeft"
                android:layout_width="@dimen/fade_edge_length"
                android:layout_height="match_parent"
                android:background="@drawable/fade_left"
                android:layout_gravity="start" />

            <View
                android:id="@+id/borrowedMajorFadeRight"
                android:layout_width="@dimen/fade_edge_length"
                android:layout_height="match_parent"
                android:background="@drawable/fade_right"
                android:layout_gravity="end" />

        </FrameLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/measuresLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/progression_label"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/borrowedMajorContainer" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/measureRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toTopOf="@id/controlsCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/measuresLabel"
        tools:itemCount="4"
        tools:listitem="@layout/item_measure" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controlsCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="0dp"
        android:paddingBottom="0dp"
        android:layout_marginBottom="0dp"
        android:background="@drawable/bg_controls_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Play/Pause on the left -->
        <ImageButton
            android:id="@+id/playPauseButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_play_arrow"
            android:contentDescription="@string/play_pause_cd"
            android:layout_marginStart="8dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="0dp"
            android:background="@drawable/bg_primary_button_ripple"
            app:tint="?attr/colorOnPrimary"
            android:scaleType="centerInside"
            android:elevation="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Stop next to Play with a small gap -->
        <ImageButton
            android:id="@+id/stopButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_stop"
            android:visibility="visible"
            android:enabled="false"
            android:alpha="0.4"
            android:contentDescription="@string/stop_cd"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_primary_button_ripple"
            app:tint="?attr/colorOnPrimary"
            android:scaleType="centerInside"
            android:elevation="4dp"
            app:layout_constraintStart_toEndOf="@id/playPauseButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Repeat anchored to the end to create a reliable large gap -->
        <ImageButton
            android:id="@+id/repeatButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_repeat_toggle_ripple"
            android:src="@drawable/ic_repeat"
            app:tint="?attr/colorOnPrimary"
            android:contentDescription="@string/toggle_repeat"
            android:elevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Optional guideline if you want to adjust exact positioning later -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/controls_center_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="0dp"
            android:orientation="vertical" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
