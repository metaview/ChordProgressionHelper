<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The base background with selector for activated state -->
    <item android:drawable="@drawable/chord_item_background" />

    <!-- The green border overlay -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="2dp"
                android:color="@color/color_target" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
