<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.ChordProgressionHelper" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Use MaterialButton widget and AlertDialog overlay from theme so dialogs/buttons are consistent -->
        <item name="materialButtonStyle">@style/Widget.ChordProgressionHelper.MaterialButton</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ChordProgressionHelper.MaterialAlertDialog</item>
    </style>

    <style name="Theme.ChordProgressionHelper" parent="Base.Theme.ChordProgressionHelper" />

    <!-- Shape appearance with rounded corners used by buttons/dialogs -->
    <style name="ShapeAppearance.ChordProgressionHelper.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">8dp</item>
    </style>

    <!-- MaterialButton widget default for the app -->
    <style name="Widget.ChordProgressionHelper.MaterialButton" parent="Widget.MaterialComponents.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.ChordProgressionHelper.SmallComponent</item>
        <!-- Textfarbe des Buttons -->
        <item name="android:textColor">@color/colorOnPrimary</item>

        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <!-- Make button background darker like chips -->
        <item name="backgroundTint">@color/purple_700</item>
        <item name="android:backgroundTint">@color/purple_700</item>
        <!-- Ripple color slightly lighter for pressed state -->
        <item name="rippleColor">?attr/colorOnPrimary</item>
    </style>

    <!-- Dialog-Buttons (ja/nein/abbrechen): Textbuttons mit weißer Schrift, damit sie gut lesbar sind. -->
    <style name="Widget.ChordProgressionHelper.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">@color/white</item>
    </style>

    <!-- Dialog overlay to ensure dialog buttons use material button styles and rounded corners -->
    <style name="ThemeOverlay.ChordProgressionHelper.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <!-- Dialog-Hintergrundfarbe -->
        <item name="colorSurface">@color/dialogBackground</item>
        <item name="android:colorBackground">@color/dialogBackground</item>

        <!-- Falls Buttons in Dialog gefüllt sein sollen, sorgt colorPrimary/colorOnPrimary dafür -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>

        <!-- Textfarbe innerhalb Dialog (z. B. Titles/Message) -->
        <item name="android:textColor">@color/dialogOnBackground</item>

        <!-- Ensure the dialog uses our materialButtonStyle for buttons -->
        <item name="materialButtonStyle">@style/Widget.ChordProgressionHelper.MaterialButton</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.ChordProgressionHelper.SmallComponent</item>

        <!-- Alle Dialog-Buttons mit weißer Schrift (positiv/negativ/neutral) -->
        <item name="buttonBarPositiveButtonStyle">@style/Widget.ChordProgressionHelper.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.ChordProgressionHelper.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.ChordProgressionHelper.DialogButton</item>
    </style>

    <!-- Fullscreen dialog style: non-floating window so we can have a full-screen editor dialog -->
    <style name="ThemeOverlay.ChordProgressionHelper.FullscreenDialog" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/dialogBackground</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- ensure Material buttons inside follow the app style -->
        <item name="materialButtonStyle">@style/Widget.ChordProgressionHelper.MaterialButton</item>
        <item name="colorSurface">@color/dialogBackground</item>
        <item name="android:colorBackground">@color/dialogBackground</item>
    </style>
</resources>
